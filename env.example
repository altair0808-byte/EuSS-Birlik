PORT=3000
# Supabase → Project Settings → Database → Connection string
DATABASE_URL=
# Supabase → Project Settings → API: Project URL и ключ service_role (логотип, печать, подписи, материалы курсов)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Папка (bucket) в Supabase Storage, по умолчанию app-uploads
SUPABASE_BUCKET=
# Секрет для входа — длинная случайная строка (64+ символов). Можно оставить пустым: сайт сам создаст секрет и сохранит в базе.
# НИКОГДА не используйте значение из примера и не выкладывайте настоящий секрет в GitHub.
JWT_SECRET=
# Логин суперадмина. Пароль задаётся только при ПЕРВОМ запуске (пусто — сайт создаст случайный и выведет в журнал);
# дальше пароль меняется на сайте: кнопка «🔑 Пароль» в шапке. После смены эту переменную можно удалить.
SUPERADMIN_LOGIN=8888
SUPERADMIN_PASSWORD=

# Упрощённая версия сайта: какие разделы включены (через запятую). Пусто — всё, как раньше.
#   biot — БиОТ (курсы с тестом, протоколы, удостоверения)   internal — внутреннее обучение
#   external — внешнее обучение                                 medbook — санкнижки (мед. книжки)
# Сотрудники, вахта, овертайм, журнал и настройки работают всегда. Данные отключённых разделов не удаляются.
# То же самое можно сделать без доступа к хостингу: «Настройки → Разделы сайта» (суперадмин).
# Пример — только БиОТ и санкнижки:
# ENABLED_FUNCTIONS=biot,medbook
ENABLED_FUNCTIONS=

# Постоянный адрес сайта для QR на удостоверениях (без слэша в конце), например https://biot.ess.kz
PUBLIC_BASE_URL=

# ---- Запасное хранилище: Google Drive (необязательно; без этих переменных сайт работает как обычно) ----
# Id папки, внутри которой сайт создаст «Протоколы» и папки объектов (ссылка .../folders/<ЭТО>)
GDRIVE_ROOT_FOLDER_ID=
# Вариант А (Google Workspace): сервисный аккаунт. Папка ДОЛЖНА лежать на Общем диске (Shared Drive),
# куда сервисный аккаунт добавлен «Редактором». Содержимое JSON-ключа целиком (или base64 от него).
GDRIVE_SERVICE_ACCOUNT_JSON=
# Вариант Б (обычный аккаунт Google): OAuth. Файлы будут занимать место этого аккаунта.
GDRIVE_OAUTH_CLIENT_ID=
GDRIVE_OAUTH_CLIENT_SECRET=
GDRIVE_OAUTH_REFRESH_TOKEN=

# ---- Уведомления на телефон (PWA / Web Push; необязательно) ----
# Ключи создаются командой:  node scripts/gen-vapid.js   (создайте один раз и не меняйте — иначе все подписки слетят)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Контакт владельца сайта: mailto:почта или https-адрес сайта
VAPID_SUBJECT=mailto:admin@example.com
# Часовой пояс для времени отправки напоминаний о сроках (09:00–18:00), по умолчанию Asia/Atyrau
PUSH_TZ=Asia/Atyrau
