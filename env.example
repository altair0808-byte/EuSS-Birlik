PORT=3000
DATABASE_URL=
JWT_SECRET=change_this_secret_in_production
SUPERADMIN_LOGIN=8888
SUPERADMIN_PASSWORD=88885555

# Постоянный адрес сайта для QR на удостоверениях (без слэша в конце), например https://biot.ess.kz
PUBLIC_BASE_URL=

# ---- Запасное хранилище: Google Drive (необязательно; без этих переменных сайт работает как обычно) ----
# Id папки, внутри которой сайт создаст «Протоколы» и папки объектов (ссылка .../folders/<ЭТО>)
GDRIVE_ROOT_FOLDER_ID=
# Вариант А (Google Workspace): сервисный аккаунт. Папка ДОЛЖНА лежать на Общем диске (Shared Drive),
# куда сервисный аккаунт добавлен «Редактором». Содержимое JSON-ключа целиком (или base64 от него).
GDRIVE_SERVICE_ACCOUNT_JSON=
# Вариант Б (обычный аккаунт Google): OAuth. Файлы будут занимать место этого аккаунта.
GDRIVE_OAUTH_CLIENT_ID=
GDRIVE_OAUTH_CLIENT_SECRET=
GDRIVE_OAUTH_REFRESH_TOKEN=
